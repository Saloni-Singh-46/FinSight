# FinSight Environment Configuration

# LLM Providers (At least one or mock mode)
LLM_PROVIDER=mock # Options: mock, openai, anthropic, ollama
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# Server & API
API_HOST=0.0.0.0
API_PORT=8000
UI_PORT=8501
DEBUG=True

# MLflow Tracking
MLFLOW_TRACKING_URI=./mlruns

# Data & Fallbacks
ENABLE_LIVE_FETCH=False
CACHE_DIR=./data/cache
DATASET_DIR=./Datasets
VECTORSTORE_DIR=./data/vectorstore

# Security
SECRET_KEY=dev_secret_key_finsight_2026
MAX_TOKENS_PER_REQUEST=4000
